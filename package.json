{
  "name": "panda-content-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A Panda reference application: an Express web app, an Express CMS, and a manifest-driven CLI.",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "tsc --noEmit",
    "cms": "tsx src/cms.ts",
    "web": "tsx src/web.ts",
    "cli": "tsx src/cli.ts",
    "validate": "tsx src/validate.ts"
  },
  "dependencies": {
    "@panda/command": "git+https://github.com/AdamPuzio/panda-command.git",
    "@panda/kernel": "git+https://github.com/AdamPuzio/panda-kernel.git",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.8",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
